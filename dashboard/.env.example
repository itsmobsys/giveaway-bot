# ==========================================================
#  Giveaway Dashboard - environment configuration
#  Copy to `.env.local` for local development.
#  Works with both Vercel and Render.
# ==========================================================

# --- Database (Turso / libSQL) ------------------------------
# Leave blank to fall back to a local SQLite file at ./data/giveaways.db
TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
TURSO_AUTH_TOKEN="eyJhbGciOi..."

# --- Discord OAuth2 ------------------------------------------
# From https://discord.com/developers/applications -> your app
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Must match a redirect URI registered in the Developer Portal.
# Vercel: https://your-app.vercel.app/api/auth/callback
# Render:  https://your-app.onrender.com/api/auth/callback
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback"

# --- Session security ------------------------------------------
# 32+ random chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
# Public URL of this deployment, used for links and CORS validation.
# Vercel: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database migration -----------------------------------------
# Local path to the shared SQL migrations when running outside a monorepo.
# Defaults to ../shared/migrations
# MIGRATIONS_DIR=""

# --- Behaviour -------------------------------------------------
# Comma-separated origins allowed to submit Server Actions.
# CSRF_TRUSTED_ORIGINS="https://your-app.vercel.app,https://your-app.onrender.com"

# Number of seconds a signed-in session stays valid.
# SESSION_MAX_AGE_SECONDS=604800

# --- Discord links ----------------------------------------------
# Public base URL of the Discord client, for jumping to a channel.
DISCORD_APP_URL="https://discord.com"

# --- Rate limiting ----------------------------------------------
# Mutations per window per admin. Also enforced in the bot.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60