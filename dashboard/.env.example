# Dashboard environment. Copy to `.env.local` for `npm run dev`.
# Production (Render/Vercel) sets these as environment variables instead.

# Same Turso database the bot uses. Leave blank for local SQLite.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SQLITE_PATH=./data/giveaways.db

# Discord OAuth2 (Developer Portal -> General Information / OAuth2).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Same token the bot uses: the dashboard verifies Manage Server against
# Discord's API on every admin page and action.
DISCORD_BOT_TOKEN=

# 32+ random characters. Signs and encrypts the session cookie.
SESSION_SECRET=

# Public URL of this dashboard. Used for CSRF origin checks and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Extra trusted origins for CSRF (comma separated). Required in production
# if the app is served from more than one origin.
CSRF_TRUSTED_ORIGINS=

# Optional tuning.
SESSION_MAX_AGE_SECONDS=604800
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60
