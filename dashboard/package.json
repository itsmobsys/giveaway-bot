{
    "name":  "giveaway-dashboard",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Open-source giveaway dashboard - Next.js on Vercel/Render with Turso/libSQL",
    "license":  "MIT",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20.9.0"
                },
    "scripts":  {
                    "dev":  "next dev --port 3000",
                    "build":  "next build",
                    "start":  "next start --port ${PORT:-3000}",
                    "lint":  "next lint",
                    "typecheck":  "tsc --noEmit",
                    "db:migrate":  "node scripts/migrate.ts",
                    "db:status":  "node scripts/migrate.ts --status",
                    "db:reset":  "node scripts/migrate.ts --reset",
                    "fairness:verify":  "node scripts/verify-fairness.ts",
                    "test":  "node --test tests/*.test.mjs",
                    "db:seed":  "node scripts/seed-dev.ts"
                },
    "dependencies":  {
                         "@libsql/client":  "^0.14.0",
                         "jose":  "^5.9.6",
                         "next":  "15.5.27",
                         "postcss":  "8.5.28",
                         "react":  "19.0.0",
                         "react-dom":  "19.0.0",
                         "zod":  "^3.24.1"
                     },
    "devDependencies":  {
                            "@tailwindcss/postcss":  "^4.0.0",
                            "@types/node":  "^22.10.7",
                            "@types/react":  "^19.0.7",
                            "@types/react-dom":  "^19.0.3",
                            "tailwindcss":  "^4.0.0",
                            "typescript":  "^5.7.3"
                        },
    "overrides":  {
                      "postcss":  "8.5.28"
                  }
}
