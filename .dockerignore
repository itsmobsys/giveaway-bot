# Keep the build context small and the image reproducible.
#
# Without this, `docker build .` on the repository root uploads node_modules and
# the Rust target directory with it - hundreds of megabytes that are then
# discarded.

# VCS
.git
.gitignore
.gitattributes

# Secrets - never bake these into an image
.env
.env.local
.env*.local
*.pem
*.key

# Dependencies and build output
# A host build (Windows, or a different glibc) must never leak into the image;
# the Dockerfile builds from source in its own stage.
rust/target
dashboard/node_modules
dashboard/.next

# Local data
data
*.db
*.db-journal
*.db-wal
*.db-shm

# Not needed to run the bot
docs/
README.md
LICENSE
docker-compose.yml
sillydev.conf
render.yaml
dashboard/
