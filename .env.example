# ==========================================================
#  Giveaway Bot - shared configuration
#  Copy to `.env` for the Python bot / docker-compose.
#  The dashboard has its own template: dashboard/.env.example
# ==========================================================

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_BOT_TOKEN=
# The ONE channel every giveaway is posted in (right-click -> Copy ID).
# Giveaways are always created here; admins cannot pick a different channel.
DISCORD_GIVEAWAY_CHANNEL_ID=
# Application ID (Developer Portal -> General Information)
DISCORD_CLIENT_ID=
# Application secret
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect URI registered in the Developer Portal.
# Local: http://localhost:3000/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Guilds the bot is allowed to operate in. Comma separated IDs. Empty = all guilds
# the bot has been invited to (Manage Server is still required everywhere).
DISCORD_GUILD_ALLOWLIST=
# Optional: guild ids the bot must never touch, even if invited.
DISCORD_GUILD_BLOCKLIST=

# --- Database ---
# Leave both blank for a local SQLite file at ./data/giveaways.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional explicit SQLite path.
SQLITE_PATH=./data/giveaways.db

# --- Bot behaviour ---
# Prefix for text commands (slash commands are unaffected).
COMMAND_PREFIX=!
# How often (seconds) the scheduler refreshes countdown embeds.
TICK_INTERVAL_SECONDS=30
# Max embeds edited per tick so we never hit Discord rate limits.
MAX_EMBED_REFRESH_PER_TICK=8
# Hard ceiling on concurrent command-queue claims.
QUEUE_WORKERS=4
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Pretty console logs (disable in production).
LOG_PRETTY=true
# Structured JSON logs (recommended on containers).
LOG_JSON=false

# --- Fairness / draws ---
# When true (recommended) entries can NEVER be deleted after a draw is locked;
# invalid entries are only *flagged*, keeping the pre-draw commitment honest.
FAIRNESS_FREEZE_ENTRIES_ON_DRAW=true
# Number of rerolls allowed per giveaway (0 = unlimited but always audited).
MAX_REROLLS_PER_GIVEAWAY=0
# Keep user identifiers out of error messages / third-party log sinks.
AUDIT_LOG_REDACT_CONTACT_DETAILS=true

# --- Optional signed HTTP control API ---
# The dashboard normally talks to the bot through the shared database queue.
# Enable this if you want the bot to also expose a signed HTTP endpoint.
ENABLE_CONTROL_API=false
CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=8787
# 32+ random bytes, shared with the dashboard as DASHBOARD_API_SECRET.
CONTROL_API_SECRET=

# --- Rate limiting (shared, database backed) ---
RATE_LIMIT_ENABLED=true
# Requests per window per actor for mutating dashboard commands.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Misc ---
# Public base URL of the dashboard, used for "view giveaway" links in embeds.
DASHBOARD_URL=http://localhost:3000
# Colour used for embeds (0xRRGGBB).
EMBED_COLOR=0x7C5CFF
# Comma separated proxy addresses you trust for X-Forwarded-For.
TRUSTED_PROXIES=