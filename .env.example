# ==========================================================
#  Giveaway Bot - configuration (copy to `.env`)
# ==========================================================

# --- Discord (https://discord.com/developers/applications) ---
# Bot token (Bot tab)
DISCORD_BOT_TOKEN=
# Optional: the ONE channel every giveaway is posted in (right-click -> Copy ID).
# Empty = the channel the command was used in.
DISCORD_GIVEAWAY_CHANNEL_ID=

# --- Database (Turso - required, the only storage) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Redis (optional short-TTL read cache) ---
# A short-TTL read cache and concurrency damper. Turso stays the single source
# of truth: every entry is still confirmed by a Turso commit before the member
# is acked, and losing Redis costs latency, never data. Leave empty to disable.
REDIS_URL=
# Switch the cache off without clearing the URL (true/false, default true).
# REDIS_ENABLED=true

# --- Bot behaviour ---
# Embed refresh + due-giveaway checks, seconds (min 5).
TICK_SECONDS=30
# Colour used for embeds (0xRRGGBB; #RRGGBB, bare RRGGBB hex and decimal also work).
EMBED_COLOR=0x7C5CFF
# Health server port. Render sets PORT itself; only set locally if needed.
# PORT=10000
# Public dashboard URL shown as a blue "Dashboard" button on every giveaway
# message. Defaults to the Vercel frontend when unset; set to a URL to override,
# or set it to empty (DASHBOARD_URL=) to remove the button.
# DASHBOARD_URL=https://giveaway-bot-duggal.vercel.app/
